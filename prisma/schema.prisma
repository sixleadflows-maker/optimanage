generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth & Users ───────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  hashedPassword String
  role           Role     @default(CASHIER)
  avatar         String   @default("")
  active         Boolean  @default(true)
  // When this was moved to the trash. Restorable for 30 days; see /dashboard/trash.
  deletedAt      DateTime?
  branchId       String?
  branch         Branch?  @relation(fields: [branchId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  salesCreated     Sale[]            @relation("SaleCreatedBy")
  salesReceived    Sale[]            @relation("SaleReceivedBy")
  returnsProcessed Return[]          @relation("ReturnProcessedBy")
  paymentsReceived SalePayment[]     @relation("PaymentReceivedBy")
  stockAdjustments StockAdjustment[]
}

enum Role {
  OWNER
  MANAGER
  CASHIER
}

// ─── Branches ───────────────────────────────────────────────

model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String   @default("")
  phone     String   @default("")
  active    Boolean  @default(true)
  deletedAt DateTime?
  createdAt DateTime @default(now())

  users     User[]
  sales     Sale[]
  cashCollections CashCollection[]
}

// ─── Customers ──────────────────────────────────────────────

model Customer {
  id            String         @id @default(cuid())
  name          String
  phone         String?        @unique
  serialNumber  String         @default("")
  email         String         @default("")
  address       String         @default("")
  totalSpend    Float          @default(0)
  visitCount    Int            @default(0)
  lastVisit     DateTime?
  // Deleting a customer moves them to the Trash (restorable for 30 days) rather
  // than erasing them, so their past invoices keep the customer's name.
  active        Boolean        @default(true)
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  prescriptions Prescription[]
  sales         Sale[]
  labOrders     LabOrder[]
}

// ─── Prescriptions ──────────────────────────────────────────

model Prescription {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  saleId     String?
  sale       Sale?    @relation(fields: [saleId], references: [id])
  date       DateTime @default(now())

  rightSph   Float    @default(0)
  rightCyl   Float    @default(0)
  rightAxis  Int      @default(0)
  rightPd    Float    @default(0)
  rightAdd   Float    @default(0)

  leftSph    Float    @default(0)
  leftCyl    Float    @default(0)
  leftAxis   Int      @default(0)
  leftPd     Float    @default(0)
  leftAdd    Float    @default(0)

  notes      String   @default("")
  // Kept out of sight on the prescription history (for everyone, on every
  // computer) until someone unhides it -- notes staff would rather not have on
  // screen with the customer standing there. The note itself is never deleted.
  notesHidden Boolean @default(false)
  isOwnPrescription Boolean @default(false)
  createdAt  DateTime @default(now())
}

// ─── Products ───────────────────────────────────────────────

model Product {
  id                String       @id @default(cuid())
  name              String
  brand             String
  model             String       @default("")
  category          String
  type              String       @default("")
  colour            String       @default("")
  size              String       @default("")
  // Free text such as lens colour or other specifications; printed on the bill.
  description       String       @default("")
  costPrice         Float        @default(0)
  salePrice         Float        @default(0)
  stock             Int          @default(0)
  barcode           String       @default("")
  lowStockThreshold Int          @default(5)
  brandTag          BrandTag     @default(UNBRANDED)
  priceThreshold    Float        @default(0)
  image             String       @default("")
  isDamaged         Boolean      @default(false)
  damageType        String       @default("")
  active            Boolean      @default(true)
  deletedAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  saleItems         SaleItem[]
  purchaseItems     PurchaseOrderItem[]
  salesAsLens       Sale[]       @relation("LensProduct")
  adjustments       StockAdjustment[]

  @@index([barcode])
  @@index([brand])
  @@index([category])
}

enum BrandTag {
  ORIGINAL
  COPY
  BRANDED
  UNBRANDED
}

model StockAdjustment {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  productName   String
  previousStock Int
  newStock      Int
  delta         Int
  reason        String
  notes         String   @default("")
  adjustedById  String?
  adjustedBy    User?    @relation(fields: [adjustedById], references: [id])
  createdAt     DateTime @default(now())
}

// ─── Sales & Orders (with Profitability Tracking) ───────────

model Sale {
  id              String        @id @default(cuid())
  invoiceNo       String        @unique
  date            DateTime      @default(now())
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  branchId        String?
  branch          Branch?       @relation(fields: [branchId], references: [id])

  items           SaleItem[]
  subtotal        Float         @default(0)
  discount        Float         @default(0)
  tax             Float         @default(0)
  total           Float         @default(0)
  paid            Float         @default(0)
  balance         Float         @default(0)

  paymentMethod   String        @default("Cash")
  paymentStatus   PaymentStatus @default(PAID)

  // Profitability tracking
  lensProductId   String?
  lensProduct     Product?      @relation("LensProduct", fields: [lensProductId], references: [id])
  lensCost        Float         @default(0)
  customLensName  String        @default("")
  // Per lens: a pair of lenses is customLensPrice x customLensQty on the bill.
  customLensPrice Float         @default(0)
  customLensQty   Int           @default(1)
  lensColor       String        @default("")
  lensDescription String        @default("")
  labCharges      Float         @default(0)
  fittingCharges  Float         @default(0)
  totalCost       Float         @default(0)
  profit          Float         @default(0)

  // Staff tracking
  createdById     String?
  createdBy       User?         @relation("SaleCreatedBy", fields: [createdById], references: [id])
  receivedById    String?
  receivedBy      User?         @relation("SaleReceivedBy", fields: [receivedById], references: [id])

  // Storefront / online orders
  source            SaleSource         @default(POS)
  fulfillmentType   FulfillmentType?
  deliveryAddress   String             @default("")
  deliveryFee       Float              @default(0)
  onlineOrderStatus OnlineOrderStatus?

  prescriptions   Prescription[]
  returns         Return[]
  payments        SalePayment[]
  // Set on a bill made while the till was offline. clientRef makes syncing it
  // idempotent (a retry finds the sale instead of creating a second one);
  // offlineRef is the temporary number printed on the customer's bill, kept
  // so searching it still finds the invoice.
  clientRef       String?       @unique
  offlineRef      String        @default("")
  // False for an old invoice entered from the paper records without touching
  // stock — deleting, restoring or editing it must not move stock either.
  stockDeducted   Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([date])
  @@index([customerId])
  @@index([invoiceNo])
}

enum SaleSource {
  POS
  ONLINE
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

enum OnlineOrderStatus {
  PROCESSING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

model SaleItem {
  id               String       @id @default(cuid())
  saleId           String
  sale             Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  // Null for an item typed in at the till that isn't in the inventory -- it's
  // sold by name and price only, with no stock to deduct.
  productId        String?
  product          Product?     @relation(fields: [productId], references: [id])
  productName      String
  description      String       @default("")
  quantity         Int          @default(1)
  unitPrice        Float        @default(0)
  discount         Float        @default(0)
  total            Float        @default(0)
  returnedQuantity Int          @default(0)

  returnItems      ReturnItem[]
}

enum PaymentStatus {
  PAID
  ADVANCE
  BALANCE
}

/// Money taken against an invoice after the sale itself — the customer coming
/// back to settle an advance. The sale's own `paid` stays the running total;
/// these rows say when each part was taken and how, so the day's cash
/// collection credits the day the money actually came in.
model SalePayment {
  id           String   @id @default(cuid())
  saleId       String
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount       Float    @default(0)
  method       String   @default("Cash")
  note         String   @default("")
  date         DateTime @default(now())
  receivedById String?
  receivedBy   User?    @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([saleId])
  @@index([date])
}

// ─── Returns & Refunds ──────────────────────────────────────
model Return {
  id            String       @id @default(cuid())
  returnNo      String       @unique
  saleId        String
  sale          Sale         @relation(fields: [saleId], references: [id])
  date          DateTime     @default(now())
  reason        String       @default("")
  refundMethod  String       @default("Cash")
  totalRefund   Float        @default(0)
  processedById String?
  processedBy   User?        @relation("ReturnProcessedBy", fields: [processedById], references: [id])
  createdAt     DateTime     @default(now())

  items         ReturnItem[]
}

model ReturnItem {
  id          String   @id @default(cuid())
  returnId    String
  return      Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId  String
  saleItem    SaleItem @relation(fields: [saleItemId], references: [id])
  productId   String
  productName String
  quantity    Int      @default(0)
  unitPrice   Float    @default(0)
  total       Float    @default(0)
}

// ─── Suppliers & Purchase Orders ────────────────────────────

model Supplier {
  id        String          @id @default(cuid())
  name      String
  contact   String          @default("")
  phone     String          @default("")
  email     String          @default("")
  address   String          @default("")
  ntn       String          @default("")
  active    Boolean         @default(true)
  // When this was moved to the trash. Restorable for 30 days; see /dashboard/trash.
  deletedAt DateTime?
  createdAt DateTime        @default(now())

  orders    PurchaseOrder[]
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  poNumber     String              @unique
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  date         DateTime            @default(now())
  total        Float               @default(0)
  status       POStatus            @default(DRAFT)

  // Order details
  supplierInvoiceNo String         @default("")
  expectedDate      DateTime?
  notes             String         @default("")

  // How the purchase is paid for
  purchaseType      String         @default("Cash") // Cash / Cheque / Other
  purchaseTypeNote  String         @default("")     // what "Other" means
  paymentMethod     String         @default("")
  paymentReference  String         @default("")     // cheque no. / transaction ID
  bankName          String         @default("")
  paymentDate       DateTime?
  amountPaid        Float          @default(0)

  createdAt    DateTime            @default(now())

  items        PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id          String        @id @default(cuid())
  orderId     String
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Null for an item ordered that isn't in the inventory yet.
  productId   String?
  product     Product?      @relation(fields: [productId], references: [id])
  productName String
  description String        @default("")
  quantity    Int           @default(0)
  unitCost    Float         @default(0)
  total       Float         @default(0)
  received    Int           @default(0)
}

enum POStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
}

// ─── Lab Orders ─────────────────────────────────────────────

model Lab {
  id        String     @id @default(cuid())
  name      String
  contact   String     @default("")
  phone     String     @default("")
  email     String     @default("")
  address   String     @default("")
  active    Boolean    @default(true)
  // When this was moved to the trash. Restorable for 30 days; see /dashboard/trash.
  deletedAt DateTime?
  createdAt DateTime   @default(now())

  orders    LabOrder[]
}

model LabOrder {
  id           String         @id @default(cuid())
  orderNo      String         @unique
  customerId   String
  customer     Customer       @relation(fields: [customerId], references: [id])
  labId        String
  lab          Lab            @relation(fields: [labId], references: [id])
  lensType     String         @default("")
  prescription String         @default("")
  price        Float          @default(0)
  status       LabOrderStatus @default(ORDERED)
  orderedDate  DateTime       @default(now())
  expectedDate DateTime?
  notes        String         @default("")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

enum LabOrderStatus {
  ORDERED
  IN_PROGRESS
  RECEIVED
  FITTED
}

// ─── Expenses ───────────────────────────────────────────────

model Expense {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  category    String
  description String   @default("")
  amount      Float    @default(0)
  paidBy      String   @default("")
  createdAt   DateTime @default(now())
}

// ─── Daily Cash Collection ──────────────────────────────────

model CashCollection {
  id            String   @id @default(cuid())
  date          DateTime @default(now())
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id])
  openingCash   Float    @default(0)
  cashSales     Float    @default(0)
  cardSales     Float    @default(0)
  bankTransfer  Float    @default(0)
  jazzCash      Float    @default(0)
  totalCollection Float  @default(0)
  expenses      Float    @default(0)
  closingCash   Float    @default(0)
  notes         String   @default("")
  closedBy      String   @default("")
  createdAt     DateTime @default(now())

  @@unique([date, branchId])
}

// ─── WhatsApp Messages ──────────────────────────────────────

model WhatsAppMessage {
  id           String        @id @default(cuid())
  to           String
  customerName String
  template     String        @default("")
  message      String
  sentAt       DateTime      @default(now())
  status       MessageStatus @default(SENT)
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

// ─── Shop Settings ──────────────────────────────────────────

model ShopSettings {
  id            String  @id @default("default")
  name          String  @default("EyeSpy")
  address       String  @default("")
  phone         String  @default("")
  email         String  @default("")
  ntn           String  @default("")
  taxRate       Float   @default(0)
  receiptFooter String  @default("")
  analyticsPin  String  @default("")
  barcodeWidth  Int     @default(2)
  barcodeHeight Int     @default(40)
  deliveryFee   Float   @default(0)
}

// Last number issued in each document series (e.g. "INV-2026"). Numbers come
// from here rather than from the invoices that still exist, so once an invoice
// is deleted its number is never handed out to a different sale.
model DocumentCounter {
  key   String @id
  value Int    @default(0)
}

// ─── Storefront Checkout ────────────────────────────────────

model CheckoutSession {
  id              String         @id @default(cuid())
  status          CheckoutStatus @default(PENDING)
  cartItems       Json
  subtotal        Float
  deliveryFee     Float          @default(0)
  total           Float
  fulfillmentType FulfillmentType
  deliveryAddress String         @default("")
  customerName    String
  customerPhone   String
  customerEmail   String         @default("")
  gatewayRef      String?        @unique
  saleId          String?        @unique
  failureReason   String         @default("")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([gatewayRef])
}

enum CheckoutStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

/// Records that are really removed when deleted (invoices, expenses,
/// prescriptions, lab orders, purchase orders, returns) are copied here first,
/// so the trash can put them back exactly as they were for 30 days. Keeping a
/// copy rather than a deletedAt flag means none of the many queries over
/// sales and expenses can accidentally count a deleted one.
model TrashEntry {
  id          String   @id @default(cuid())
  kind        String
  recordId    String
  title       String
  detail      String   @default("")
  data        Json
  deletedAt   DateTime @default(now())
  deletedById String?

  @@index([deletedAt])
}
